# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_PASSWORD: Password to access the Admin Panel (default: admin123)
ADMIN_PASSWORD="admin123"

# JWT_SECRET: Secret for signing temporary session access tokens
SESSION_SECRET="super-secret-doc-vault-key-2026"

# SUPABASE CONFIGURATION (Optional - system falls back to local persistent disk store if not set)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
